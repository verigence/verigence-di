# ============================================================
# Verigence DI — Environment Variables
# Copy this file to infra/.env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ============================================================

# ── Application ───────────────────────────────────────────────────────────────
DI_ENV=local                          # local | dev | production
DI_SECRET_KEY=replace-with-32-char-random-string   # min 32 chars
DI_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DI_LOG_STDOUT=true                    # local/container structured logging remains independent

# ── Database ──────────────────────────────────────────────────────────────────
DI_DATABASE_URL=postgresql://user:password@localhost:5432/verigence_di

# ── Storage (R2 / MinIO) ──────────────────────────────────────────────────────
DI_STORAGE_PROVIDER=minio             # minio | r2
DI_STORAGE_ENDPOINT=http://localhost:9000
DI_STORAGE_ACCESS_KEY_ID=minioadmin
DI_STORAGE_SECRET_ACCESS_KEY=minioadmin123
DI_STORAGE_BUCKET=verigence-di-dev
DI_STORAGE_REGION=us-east-1

# ── Auth — Security module JWKS ───────────────────────────────────────────────
DI_SECURITY_JWKS_URL=                 # https://<security-host>/.well-known/jwks.json

# ── AI / OCR — Gemini 2.5 Flash ──────────────────────────────────────────────
DI_DOCAI_MOCK=true                    # true = mock adapter (local/CI); false = real Gemini
DI_DOCAI_GEMINI_API_KEY=              # Google AI Studio API key (required when MOCK=false)

# ── Processing Worker ─────────────────────────────────────────────────────────
DI_WORKER_ENABLED=true                # false = API-only mode (no background worker)
DI_WORKER_POLL_INTERVAL_SECONDS=5     # seconds between job queue polls
DI_WORKER_ID=                         # auto-generated from hostname+PID when empty
DI_WORKER_LEASE_TIMEOUT_MINUTES=10    # minutes before a stuck RUNNING job is reclaimed

# ── Backout queue (D24) ───────────────────────────────────────────────────────
DI_BACKOUT_TTL_HOURS=12               # hours before a failed job's backout row expires

# ── Verification ──────────────────────────────────────────────────────────────
DI_VERIFICATION_THRESHOLD=90.00       # confidence score below which human review required

# ── Observability ─────────────────────────────────────────────────────────────
DI_SENTRY_DSN=                        # Sentry DSN (leave empty to disable)

# Independent remote telemetry switches. All are opt-in. Tracing is intentionally
# false by default because it has the highest runtime/I/O overhead.
# Logs=true forwards every sanitized DI application event.
# Errors=true can be used with Logs=false for errors-only remote logging.
DI_OBSERVABILITY_LOGS_ENABLED=false
DI_OBSERVABILITY_ERRORS_ENABLED=false
DI_OBSERVABILITY_METRICS_ENABLED=false
DI_OBSERVABILITY_TRACES_ENABLED=false
DI_OBSERVABILITY_SERVICE_NAME=verigence-di

# Bounded, asynchronous OTLP export. Telemetry is fail-open and must never block
# document processing if Axiom/OTLP is unavailable.
DI_OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2
DI_OBSERVABILITY_BATCH_DELAY_MS=1000
DI_OBSERVABILITY_MAX_QUEUE_SIZE=2048
DI_OBSERVABILITY_MAX_EXPORT_BATCH_SIZE=512
DI_OBSERVABILITY_METRIC_EXPORT_INTERVAL_MS=60000

# Standard OpenTelemetry OTLP/HTTP configuration for Axiom. Configure only the
# signals you enable above. The endpoint/header variables are intentionally the
# standard OTEL names (not DI_ names) because the OTel SDK consumes them directly.
# Never commit real Axiom tokens.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://<axiom-domain>/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-di-logs
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<axiom-domain>/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Bearer <token>,x-axiom-metrics-dataset=verigence-di-metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://<axiom-domain>/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-di-traces

# Emit structured log events for successful mutating operations (document upload, delete).
# Set to false to suppress success-path logs in high-throughput environments.
DI_SUCCESS_EVENTS_ENABLED=true
