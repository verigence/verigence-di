# ============================================================
# Verigence DI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ============================================================

# ----- Application -----
DI_ENV=local
DI_SECRET_KEY=change-me-in-production-use-32-chars-minimum
DI_LOG_LEVEL=INFO

# ----- Database (Neon in dev/prod, local PG in docker) -----
DI_DATABASE_URL=postgresql+asyncpg://verigence:verigence_dev@localhost:5432/verigence_di
# Production example (Neon):
# DI_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/verigence_di?sslmode=require

# ----- Object Storage -----
# Local Docker (MinIO):
DI_STORAGE_PROVIDER=minio
DI_STORAGE_ENDPOINT=http://localhost:9000
DI_STORAGE_ACCESS_KEY_ID=minioadmin
DI_STORAGE_SECRET_ACCESS_KEY=minioadmin123
DI_STORAGE_BUCKET=verigence-di-dev
DI_STORAGE_REGION=us-east-1

# Cloudflare R2 (DEV / PROD):
# DI_STORAGE_PROVIDER=r2
# DI_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DI_STORAGE_ACCESS_KEY_ID=<r2-access-key>
# DI_STORAGE_SECRET_ACCESS_KEY=<r2-secret-key>
# DI_STORAGE_BUCKET=verigence-di-dev
# DI_STORAGE_REGION=auto

# ----- Auth (Clerk) -----
DI_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
DI_CLERK_SECRET_KEY=sk_test_replace_me
DI_CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json

# ----- Google Document AI -----
# Set DI_DOCAI_MOCK=true locally to skip real API calls
DI_DOCAI_MOCK=true
DI_DOCAI_PROJECT_ID=your-gcp-project-id
DI_DOCAI_LOCATION=us
DI_DOCAI_PROCESSOR_ID=your-processor-id
# Path to downloaded GCP service account JSON key (local dev only)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ----- Sentry (optional) -----
DI_SENTRY_DSN=

# ----- Railway internal (set automatically in Railway) -----
# PORT=8000
